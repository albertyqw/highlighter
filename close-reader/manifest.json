{
  "manifest_version": 3,
  "name": "Close Reader",
  "version": "0.5.0",
  "description": "Five-colour highlighting and notes for reading on the web.",
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["https://api.notion.com/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'" },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Close Reader: turn highlighting on or off (Alt+Shift+H)" },
  "commands": {
    "toggle-highlighter": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Turn highlighting on or off"
    },
    "toggle-panel": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Show or hide the notes panel"
    },
    "capture-screenshot": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capture a screenshot for this page's notes"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["article.js", "messaging.js", "content.js"],
      "css": ["marks.css"],
      "run_at": "document_idle"
    }
  ]
}
